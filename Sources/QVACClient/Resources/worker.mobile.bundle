      if (whence === AVSEEK_SIZE) return size
      let next
      if (whence === 0) next = offset
      else if (whence === 1) next = pos + offset
      else if (whence === 2) next = size + offset
      else return -1
      if (next < 0) return -1
      pos = next
      return pos
