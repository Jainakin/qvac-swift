  "name": "bare-http-parser",
  "version": "1.1.5",
  "description": "Streaming HTTP request and response parser for Bare",
  "exports": {
    "./package": "./package.json",
    ".": "./index.js",
    "./errors": "./lib/errors.js"
  },
  "files": [
    "index.js",
