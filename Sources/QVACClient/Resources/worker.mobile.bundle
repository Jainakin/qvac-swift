import fs from 'bare-fs';
import path from 'bare-path';
import os from 'bare-os';
import { getServerLogger } from '../../logging/index.js';
import { getQvacPath } from '../../server/utils/qvac-paths.js';
const logger = getServerLogger();
const LOCK_FILENAME = '.worker.lock';
function getLockFilePath() {
    return getQvacPath(LOCK_FILENAME);
}
function isProcessAlive(pid) {
    try {
        os.kill(pid, 0);
        return true;
    }
    catch {
        return false;
    }
}
function readLockFile(lockPath) {
    try {
        if (!fs.existsSync(lockPath))
            return null;
        const raw = fs.readFileSync(lockPath, 'utf-8');
        return JSON.parse(raw);
    }
    catch {
        return null;
    }
}
export function acquireWorkerLock() {
    const lockPath = getLockFilePath();
    const existing = readLockFile(lockPath);
    if (existing) {
        if (isProcessAlive(existing.pid)) {
            logger.warn(`Another worker (PID ${existing.pid}) is still running — lock file exists at ${lockPath}`);
        }
        else {
            logger.warn(`Stale lock file detected (PID ${existing.pid} is dead, started ${existing.startedAt}). Removing.`);
        }
    }
    const content = {
        pid: os.pid(),
        startedAt: new Date().toISOString()
    };
    try {
        fs.mkdirSync(path.dirname(lockPath), { recursive: true });
        fs.writeFileSync(lockPath, JSON.stringify(content));
        logger.debug(`Worker lock acquired (PID ${os.pid()})`);
    }
    catch (error) {
        logger.error('Failed to write worker lock file:', error instanceof Error ? error.message : String(error));
    }
}
export function releaseWorkerLock() {
    const lockPath = getLockFilePath();
    try {
        const existing = readLockFile(lockPath);
        if (existing && existing.pid === os.pid()) {
            fs.unlinkSync(lockPath);
            logger.debug('Worker lock released');
        }
    }
    catch {
        // Best-effort — may already be gone
    }
}
