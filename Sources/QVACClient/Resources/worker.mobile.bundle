    this._columnsFlushed = true

    const lock = this._lock === null ? -1 : this._lock.transfer()

    req.handle = binding.open(
      this._handle,
      this,
      this.path,
      this.columnFamilies.map((c) => c._handle),
      lock,
      req,
      onopen
