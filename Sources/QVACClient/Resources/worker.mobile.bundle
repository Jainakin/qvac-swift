      throw errors.PIPE_IS_CLOSED('Pipe is closed')
    }

    if (this._state & (constants.state.CONNECTING | constants.state.CONNECTED)) {
      throw errors.PIPE_ALREADY_CONNECTED('Pipe is already connected')
    }

    if (typeof opts === 'function') {
      onconnect = opts
      opts = {}
