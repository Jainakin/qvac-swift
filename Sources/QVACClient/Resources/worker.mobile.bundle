// Nukta marks (diacritical dots) in various Indic scripts
// https://en.wikipedia.org/wiki/Nuqta
const NUKTAS = [
  '\u093C', // Devanagari  ◌़
  '\u09BC', // Bengali  ◌়
  '\u0A3C', // Gurmukhi  ◌਼
  '\u0ABC', // Gujarati  ◌઼
  '\u0AFD', // Gujarati Sign Three-Dot Above ◌૽
  '\u0AFE', // Gujarati Sign Circle Above ◌૾
  '\u0AFF', // Gujarati Sign Two-Circle Above ◌૿
  '\u0B3C', // Oriya  ◌଼
  '\u0CBC', // Kannada  ◌಼
  '\u1C37', // Lepcha  ◌᰷
  '\u{110BA}', // Kaithi  ◌𑂺
