  _encodeKey(k) {
    if (this.db._keyEncoding) return c.encode(this.db._keyEncoding, k)
    if (typeof k === 'string') return Buffer.from(k)
    if (k === null) return empty
    return k
  }

  diagnostics() {
    return {
      suspended: this._suspended,
      suspending: this._suspending,
      updating: this._updating,
      resumedPending: this.resumed !== null,
      io: this.io.count,
      handles: this.handles.count,
      sessions: this.sessions.length
    }
  }
}

function encodePrefix(prefix) {
  if (typeof prefix === 'string') return Buffer.from(prefix)
  return prefix
}
