  for (const key in map) {
    if (key === 'constructor') continue

    const value = inspectValue(map[key], depth + 1, opts)

    values.push(
      new InspectPair(': ', inspectKey(key, depth + 1, opts), value, depth + 1, {
        ...opts,
        breakAlways: remaining < 0
      })
    )
