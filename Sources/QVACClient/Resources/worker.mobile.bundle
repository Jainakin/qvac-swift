      case 'MX':
        return this.resolveMx(hostname, cb)
      case 'NAPTR':
        return this.resolveNaptr(hostname, cb)
      case 'NS':
        return this.resolveNs(hostname, cb)
      case 'PTR':
        return this.resolvePtr(hostname, cb)
      case 'SOA':
