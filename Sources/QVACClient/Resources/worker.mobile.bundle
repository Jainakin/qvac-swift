   * @param {string} text - Input Devanagari text
   * @returns {string} - Transliterated Sinhala text
   */
  static devanagariToSinhala (text) {
    return Array.from(text)
      .map((c) => SinhalaDevanagariTransliterator.devnagSinhalaMap[c] || c)
      .join('')
