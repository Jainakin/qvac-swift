}
function isStringArray(source) {
    return Array.isArray(source);
}
function getMisplacedModelConfigKeys(value) {
    if (!isRecord(value) || typeof value['modelType'] !== 'string')
        return [];
    const configKeys = modelConfigKeysByModelType.get(normalizeModelType(value['modelType']));
    if (!configKeys)
