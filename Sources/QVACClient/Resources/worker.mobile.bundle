  }

  async getStatsLevel() {
    if (this.opened === false) await this.ready()

    return binding.statsLevelGet(this._handle)
  }

  async setStatsLevel(level) {
    if (this.opened === false) await this.ready()

    binding.statsLevelSet(this._handle, level)
  }

  async getProperty(name) {
    if (this.opened === false) await this.ready()

    return binding.propertyGet(this._handle, name)
