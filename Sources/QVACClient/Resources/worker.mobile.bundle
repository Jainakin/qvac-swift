import { ModelAlreadyRegisteredError, ModelNotFoundError, ModelIsDelegatedError } from '../../../utils/errors-server.js';
import { getServerLogger } from '../../../logging/index.js';
const logger = getServerLogger();
// Global registry state - using stateless functions to manage it
const modelRegistry = new Map();
export function registerModel(id, options) {
