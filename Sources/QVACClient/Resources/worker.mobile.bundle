const { MosesTokenizer, MosesDetokenizer } = require('./tokenizer')
const { MosesPunctNormalizer } = require('./normalizer')

module.exports = {
  MosesTokenizer,
  MosesDetokenizer,
  MosesPunctNormalizer
}
// Virama marks (vowel killers) in various Indic scripts
const VIRAMAS = [
  '\u094D', // Devanagari ◌्
  '\u09CD', // Bengali ◌্
  '\u0A4D', // Gurmukhi ◌੍
  '\u0ACD', // Gujarati ◌્
