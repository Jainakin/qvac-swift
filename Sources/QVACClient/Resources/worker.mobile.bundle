function routeLog(logger, level, message) {
    switch (level) {
        case 'error':
            logger.error(message);
            break;
        case 'warn':
            logger.warn(message);
            break;
        case 'info':
            logger.info(message);
            break;
        case 'debug':
            logger.debug(message);
            break;
    }
}
