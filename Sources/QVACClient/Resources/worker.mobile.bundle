import Corestore from 'corestore';
import fs, { promises as fsPromises } from 'bare-fs';
import path from 'bare-path';
import { getConfiguredCacheDir } from '../../../server/bare/registry/config-registry.js';
import { RAGWorkspaceModelMismatchError, RAGWorkspaceNotOpenError } from '../../../utils/errors-server.js';
import { validateAndJoinPath } from '../../../server/utils/path-security.js';
import { createStreamLogger, getServerLogger, RAG_NAMESPACE } from '../../../logging/index.js';
import { cancelAllRagOperations } from '../../../server/bare/rag-hyperdb/rag-operation-manager.js';
