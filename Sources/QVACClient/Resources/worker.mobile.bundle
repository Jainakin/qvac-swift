  onplugin(req) {
    if (!req.value) return

    const plugreq = decode(m.pluginRequest, req.value)
    if (plugreq === null) return

    const p = this.dht.plugins.get(plugreq.plugin)
    if (!p || p.version !== plugreq.version) return

    p.onrequest(plugreq, req)
