        throw new ModelAlreadyRegisteredError(id);
    }
    const isDelegated = 'providerPublicKey' in options;
    if (isDelegated) {
        const { providerPublicKey, timeout, healthCheckTimeout } = options;
        modelRegistry.set(id, {
            id,
            isDelegated: true,
            delegated: {
                providerPublicKey,
                timeout,
                healthCheckTimeout
            }
        });
        logger.info(`Delegated model registered: ${id} -> provider: ${providerPublicKey}, timeout: ${timeout}ms`);
    }
    else {
