  '\u{11839}', // Dogra ◌𑠹
  '\u{119E0}', // Nandinagari ◌𑧠
  '\u{11A34}', // Zanabazar Square ◌𑨴
  '\u{11C3F}', // Bhaiksuki ◌𑰿
  '\u{11D45}', // Masaram Gondi ◌𑵅
