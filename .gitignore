# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved
xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/

# Bench artifacts (the bench builds its own .build via its own Package.swift)
bench/swift/.build/
bench/evidence/
bench/.streaming-benchmark.lock/

# Xcode
*.xcworkspace/xcuserdata/

# Node tooling for codegen
tools/codegen/node_modules/
tools/codegen/.build/

# Reproducible worker/artifact toolchain (package-locks are committed).
tools/runtime/node_modules/
tools/runtime/.build/
tools/runtime/qvac/
release-candidate/

# Exact-source BareKit candidate builder (locks and patch remain committed).
tools/native/bare-kit/node_modules/
tools/native/bare-kit/.build/

# qvac-sparse is a separate git clone of the QVAC SDK source for codegen reference.
# It's regenerated by `git clone --depth 1 --filter=blob:none --sparse https://github.com/tetherto/qvac.git`.
qvac-sparse/

# Temp + output
/tmp/
*.tmp
*.log
*.profdata
*.profraw
result.json

# macOS
.DS_Store

# Local editor settings
.claude/
.cursor/

# Local experimental workspaces (not part of the distributable package)
/spike-js/
/spike-swift/

# Xcode-generated project files (regenerated by xcodegen)
Examples/QVACChat/QVACChat.xcodeproj/

# Package.swift.release is a disposable URL-manifest output. The canonical
# Package.swift is generated from a verified non-publishing candidate before its
# matching immutable artifacts are published. Package.swift.dev is tracked.
Package.swift.release
Package.swift.release-broken

# Local review artifacts
Examples/QVACChat/.physical-proof.*/
Package.swift.release-broken-from-private-repo
