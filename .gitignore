# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved
xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/

# Bench artifacts (the bench builds its own .build via its own Package.swift)
bench/swift/.build/

# qvac CLI bundle output (regenerated by tools/build/release.sh)
spike-js/qvac/

# Xcode
*.xcworkspace/xcuserdata/

# Generated by xcodegen for the example/probe app
spike-swift/Examples/BareKitProbeApp/BareKitProbeApp.xcodeproj/

# Node tooling for codegen
tools/codegen/node_modules/
tools/codegen/package-lock.json

# Spike workspace artifacts (kept in repo for evidence, but ignore caches)
spike-js/node_modules/
spike-js/qvac-sparse/
spike-js/*.json
spike-js/qvac/
spike-swift/.build/

# qvac-sparse is a separate git clone of the QVAC SDK source for codegen reference.
# It's regenerated by `git clone --depth 1 --filter=blob:none --sparse https://github.com/tetherto/qvac.git`.
qvac-sparse/

# Temp + output
/tmp/
*.tmp
*.log
result.json

# macOS
.DS_Store

# Editor / agent config (per-developer)
.claude/
.cursor/

# Xcode-generated project files (regenerated by xcodegen)
Examples/QVACChat/QVACChat.xcodeproj/

# Vendored addon xcframeworks — populated by tools/dev/vendor-from-release.sh
# from a GitHub Release. Total ~400 MB; too big to commit. BareKit is the one
# exception — it's the host runtime, ~96 MB, and is the foundation that the
# vendor script's @rpath closure walk starts from.
spike-swift/Vendor/*.xcframework/
!spike-swift/Vendor/BareKit.xcframework/

# Package.swift backups created by tools/release/prepare-release.sh — not the
# source of truth. Package.swift is the dev-mode manifest; .dev is created
# when swapping to release-mode (URL-based binaryTargets) and consumed when
# swapping back.
Package.swift.dev
Package.swift.release-broken
