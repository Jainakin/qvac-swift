# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved
xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/

# Bench artifacts (the bench builds its own .build via its own Package.swift)
bench/swift/.build/

# qvac CLI bundle output (regenerated by tools/build/release.sh)
spike-js/qvac/

# Xcode
*.xcworkspace/xcuserdata/

# Generated by xcodegen for the example/probe app
spike-swift/Examples/BareKitProbeApp/BareKitProbeApp.xcodeproj/

# Node tooling for codegen
tools/codegen/node_modules/
tools/codegen/.build/

# Reproducible worker/artifact toolchain (package-locks are committed).
tools/runtime/node_modules/
tools/runtime/.build/
tools/runtime/qvac/
release-candidate/

# Spike workspace artifacts (kept in repo for evidence, but ignore caches)
spike-js/node_modules/
spike-js/qvac-sparse/
spike-js/*.json
spike-js/qvac/
spike-swift/.build/

# qvac-sparse is a separate git clone of the QVAC SDK source for codegen reference.
# It's regenerated by `git clone --depth 1 --filter=blob:none --sparse https://github.com/tetherto/qvac.git`.
qvac-sparse/

# Temp + output
/tmp/
*.tmp
*.log
result.json

# macOS
.DS_Store

# Editor / agent config (per-developer)
.claude/
.cursor/

# Xcode-generated project files (regenerated by xcodegen)
Examples/QVACChat/QVACChat.xcodeproj/

# Legacy prototype XCFrameworks are retained locally for historical evidence.
# Ignore generated addon copies; BareKit remains the one tracked prototype root.
spike-swift/Vendor/*.xcframework/
!spike-swift/Vendor/BareKit.xcframework/

# Package.swift.release is generated only after immutable binary artifacts are
# published and verified. Package.swift.dev is a tracked development manifest.
Package.swift.release
Package.swift.release-broken
